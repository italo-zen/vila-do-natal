{
  "name": "natal-na-casa-do-tio-italo",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Natal na Casa do Tio Ítalo e da Tia Nath",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:playtest": "tsc --noEmit && vite build --config vite.playtest.config.ts && node tools/verificar-sem-gancho.mjs",
    "build:release": "tsc --noEmit && vite build --config vite.release.config.ts && node tools/verificar-sem-gancho.mjs dist-release/index.html",
    "verificar:tamanho": "node tools/verificar-tamanho.mjs",
    "verificar:audio": "/usr/bin/python3 tools-arte/gerar_audio.py --verificar",
    "verificar:release": "node tools/verificar-release.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "gen:assets": "node tools/gerar-assets.mjs",
    "gen:conteudo": "python3 tools-arte/tmx_para_conteudo.py --girar",
    "smoke:playtest": "node tools/smoke-navegador.mjs dist-playtest/index.html dist-playtest/capturas && node tools/smoke-toque.mjs dist-playtest/index.html dist-playtest/capturas-toque && node tools/smoke-imagem-de-tela.mjs dist-playtest/index.html",
    "validar:perfil": "node tools/validar-perfil.mjs",
    "comparar:capturas": "node tools/comparar-capturas.mjs",
    "verificar:conteudo": "python3 tools-arte/tmx_para_conteudo.py --girar --verificar && vitest run tests/conteudo/decoracao-real.test.ts",
    "build:qa": "tsc --noEmit && vite build --config vite.qa.config.ts",
    "smoke:toque-menus": "node tools/smoke-toque-menus.mjs dist-qa/index.html dist-qa/capturas-menus",
    "smoke:pausa-som": "node tools/smoke-pausa-som.mjs dist-qa/index.html dist-qa/capturas-pausa",
    "smoke:icones": "node tools/smoke-icones.mjs dist-qa/index.html dist-qa/capturas-icones",
    "smoke:release": "node tools/smoke-release.mjs dist-release",
    "smoke:imagem": "node tools/smoke-imagem-de-tela.mjs dist-qa/index.html --com-fim"
  },
  "dependencies": {
    "@fontsource/press-start-2p": "^5.2.5",
    "phaser": "^3.90.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "playwright-core": "^1.65.0",
    "typescript": "^5.9.3",
    "vite": "^8.3.6",
    "vite-plugin-singlefile": "^2.3.4",
    "vitest": "^5.1.0"
  }
}
